{
  "name": "quiz-royale-showdown",
  "private": true,
  "workspaces": [
    "backend",
    "webapp"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:webapp": "npm run dev -w webapp",
    "smoke:phase1": "node load-test/phase1-live-flow-smoke.mjs",
    "smoke:phase2": "node load-test/phase2-full-loop-smoke.mjs",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w webapp",
    "test": "npm run test -w backend && npm run test -w webapp"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "postcss": "8.5.18",
    "fast-uri": "3.1.4",
    "react-router": "6.30.4",
    "react-router-dom": "6.30.4",
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.7"
    },
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "socket.io": {
      "engine.io": "6.6.9",
      "socket.io-adapter": "2.5.8"
    },
    "socket.io-client": {
      "engine.io-client": "6.6.6"
    },
    "vite": {
      ".": "8.1.0",
      "esbuild": "0.28.1"
    },
    "ws": "8.21.0"
  }
}
