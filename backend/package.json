{
  "name": "@quiz-royale/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --exclude dist/**",
    "test:watch": "vitest --pool=threads",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "tsx src/scripts/seed.ts",
    "fetch:opentdb": "tsx src/scripts/fetchOpenTriviaDB.ts",
    "generate:questions": "tsx src/scripts/generateAIQuestions.ts",
    "generate:targeted": "tsx src/scripts/generateTargeted.ts",
    "audit:questions": "tsx src/scripts/auditQuestions.ts",
    "consolidate:categories": "tsx src/scripts/consolidateCategories.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@sentry/node": "^10.60.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.34.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.7.0",
    "socket.io": "^4.8.3",
    "ulid": "^2.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "axios": {
      "form-data": "4.0.6"
    },
    "engine.io": "6.6.9",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "socket.io": {
      "engine.io": "6.6.9",
      "socket.io-adapter": "2.5.8"
    },
    "socket.io-client": {
      "engine.io-client": "6.6.6"
    },
    "socket.io-adapter": "2.5.8",
    "vite": "8.1.0",
    "ws": "8.21.0"
  }
}
